# Dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
build/
.output/
*.tsbuildinfo
.turbo/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Secrets and local environment
.env
.env.*
!.env.example

# Agent scratch space
.scratch/

# Agent working state. `.claude/worktrees/` holds whole git worktrees of this repository when work is fanned
# out across isolated copies, so a plain `git add -A` commits them as embedded repositories — which it did
# once, and the commit had to be amended. Ignored rather than remembered.
.claude/

# Test and coverage
coverage/
.nyc_output/
*.log

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Generated by `wrangler types` — regenerate rather than commit
worker-configuration.d.ts
# One per vitest config, all three read by .github/scripts/test-headroom.mjs on CI.
.vitest-report.json
.vitest-report-node.json
.vitest-report-client.json

# Browser-automation scratch: snapshots and screenshots from visual verification.
# The findings belong in a commit message or a receipt; the PNGs are not evidence of anything reproducible.
.playwright-mcp/

# esbuild's output for the React application (ADR 30). Built by wrangler's own `build.command`, so every
# deploy path produces it; not committed, because it would put a hundred kilobytes of minified diff on
# every interface commit and a reviewer cannot notice anything wrong inside it.
apps/node/worker/generated/

# Derived by `mailda deploy --name <worker>` from wrangler.jsonc; never committed (ADR 24)
apps/node/worker/wrangler.*.jsonc

# The site's docs pages are rendered from README.md, AGENTS.md and docs/ by `apps/site/scripts/generate-docs.mjs`
# on every build; committing them would put a second copy of every doc in the tree, one edit behind the first.
apps/site/src/content/docs/docs/
apps/site/public/install.sh
apps/site/.astro/
