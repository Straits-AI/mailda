{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "@mailda/receipts#generate": {
      "inputs": [
        "../../docs/receipts/**/*.md",
        "src/**"
      ],
      "outputs": [
        "../budgets/src/generated.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "@mailda/receipts#generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "@mailda/receipts#generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "@mailda/receipts#generate"
      ],
      "outputs": []
    },
    "@mailda/site#test": {
      "dependsOn": [
        "^build",
        "@mailda/receipts#generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../README.md",
        "../../AGENTS.md",
        "../../docs/**/*.md",
        "../node/worker/src/i18n/glossary.ts",
        "../../install.sh",
        "../../update.sh"
      ],
      "outputs": []
    },
    "bench": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
