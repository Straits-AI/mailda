{
  "name": "mailda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "receipts": "turbo @mailda/receipts#generate",
    "receipts:check": "pnpm receipts && git diff --exit-code packages/budgets/src/generated.ts",
    "bench": "turbo bench",
    "deploy": "pnpm --filter @mailda/worker run deploy",
    "set-password": "pnpm --filter @mailda/worker run set-password"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
