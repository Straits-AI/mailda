{
  "name": "@mailda/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "bench": "vitest run --mode bench",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy": "wrangler deploy && pnpm run migrations:apply",
    "migrations:apply": "wrangler d1 migrations apply CATALOG --remote",
    "set-password": "node --experimental-strip-types scripts/set-password.mjs"
  },
  "dependencies": {
    "@mailda/budgets": "workspace:*",
    "@mailda/evidence": "workspace:*",
    "@mailda/runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postal-mime": "^2.7.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.68.0",
    "yaml": "^2.9.0"
  }
}
