---
import mark from "../assets/mark.svg?raw";
import "../styles/site.css";
import { WORDS, type SiteLocale } from "../landing-words.ts";

interface Props { gaps: { title: string; detail: string }[]; locale: SiteLocale }
const { gaps, locale } = Astro.props;
const w = WORDS[locale];
/** Where this locale's pages live: Starlight's zh-cn locale serves the docs under /zh-cn/docs/, English at the root. */
const base = locale === "en" ? "" : "/zh-cn";
/** The README's rows are English on every page; under another language they say so with `lang`. */
const readmeLang = locale === "en" ? undefined : "en";

/*
 * The landing page as a doctor report (the roll of 18 September). Every `ok` line names a doc that holds it
 * to account; every `warn` line is the README's own gap table, read at build time and unedited. The copy
 * above the report is for the owner; the report is for the builder. Nothing here is a claim the repository
 * does not make. The words are `src/landing-words.ts`; what stays here is what is not words: check ids, files, paths.
 */
const checks = [
  { check: "install", doc: "deploy-drill-live-account.md", href: "/docs/receipts/deploy-drill-live-account/" },
  { check: "receiving", doc: "application-shell.md", href: "/docs/product/application-shell/" },
  { check: "mail_security", doc: "mail-security.md", href: "/docs/product/mail-security/" },
  { check: "sending", doc: "send-breakers.md", href: "/docs/operating/send-breakers/" },
  { check: "butlers", doc: "butler-engine.md", href: "/docs/product/butler-engine/" },
  { check: "your_ai", doc: "machine-surfaces.md", href: "/docs/operating/machine-surfaces/" },
  { check: "governance", doc: "supervised-access.md", href: "/docs/product/supervised-access/" },
  { check: "custody", doc: "disaster-recovery.md", href: "/docs/operating/disaster-recovery/" },
] as const;
const status = `${base}/docs/readme/#status-functional-alpha-not-production-ready`;
---
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{w["page.title"]}</title>
  <meta name="description" content={w["page.description"]} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={w["page.ogTitle"]} />
  <meta property="og:description" content={w["page.ogDescription"]} />
</head>
<body class="landing">
  <header class="masthead">
    <a class="lockup" href={`${base}/`} aria-label={w["brand"]}><span class="mark" set:html={mark}></span><span class="word">{w["brand"]}</span>{w["brand.secondary"] !== null && <span class="word-secondary" lang="en">{w["brand.secondary"]}</span>}</a>
    <nav class="masthead-nav" aria-label={w["nav.label"]}>
      <a href={`${base}/docs/readme/`}>{w["nav.docs"]}</a>
      <a href={`${base}/docs/receipts/`}>{w["nav.receipts"]}</a>
      <a href="https://github.com/Straits-AI/mailda">GitHub</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">{w["hero.title"]}</h1>
      <p class="lede">
        {w["lede.before"]}<strong>{w["lede.strong"]}</strong>{w["lede.after"]}
      </p>
      <p class="owner">
        <span class="label">{w["owner.label"]}</span>
        {w["owner.before"]}<strong>{w["owner.strong"]}</strong>{w["owner.after"]}
      </p>
      <p class="actions">
        <a class="primary" href={`${base}/docs/readme/#installing-it`}>{w["action.install"]}</a>
        <a class="quiet" href={`${base}/docs/operating/machine-surfaces/`}>{w["action.ai"]}</a>
      </p>
    </section>

    <section class="report" aria-labelledby="report-title">
      <h2 id="report-title" class="report-head">
        <span class="cmd">mailda doctor</span>
        <span class="verdict">{w["report.verdict"]}</span>
        <span class="dim">{w["report.about"]}</span>
      </h2>
      <ol class="findings">
        {checks.map((one) => (
          <li class="finding">
            <span class="sev ok">ok</span>
            <span class="check">{one.check}</span>
            <span class="says">{w[`ok.${one.check}`]} <a class="doc" href={`${base}${one.href}`}>{one.doc}</a></span>
          </li>
        ))}
        {w["gaps.heading"] !== null && <li class="gaps-head"><h3>{w["gaps.heading"]}</h3></li>}
        {gaps.map((gap) => (
          <li class="finding" lang={readmeLang}>
            <span class="sev warn">warn</span>
            <span class="check">{gap.title.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim().split(" ").slice(0, 3).join("_")}</span>
            <span class="says"><strong>{gap.title}.</strong> {gap.detail} <a class="doc" href={status}>README</a></span>
          </li>
        ))}
        <li class="finding">
          <span class="sev report">report</span>
          <span class="check">receipts</span>
          <span class="says">{w["receipts.says"]} <a class="doc" href={`${base}/docs/receipts/`}>docs/receipts/</a></span>
        </li>
      </ol>
      <p class="report-foot dim">
        {w["foot.before"]}
        <a href={status}>{w["foot.link"]}</a>{w["foot.after"]}
      </p>
    </section>

    <section class="install" aria-labelledby="install-title">
      <h2 id="install-title">{w["install.title"]}</h2>
      <div class="terminal">
        <pre><code id="install-command">curl -fsSL https://mailda.site/install.sh | bash</code></pre>
        <button type="button" class="copy" data-copy="install-command" aria-label={w["install.copyLabel"]}>{w["install.copy"]}</button>
      </div>
      <p class="dim">
        {w["install.about"]}
        <a href={`${base}/docs/operating/cloudflare-settings/`}>{w["install.settings"]}</a>
      </p>
      <p class="dim">
        {w["update.before"]}<code>curl -fsSL https://mailda.site/update.sh | bash</code>{w["update.after"]}
      </p>
    </section>

    <section class="values" aria-label={w["values.label"]}>
      <ul>
        <li><strong>{w["value.intelligent"]}</strong>{w["value.intelligent.says"]}</li>
        <li><strong>{w["value.reliable"]}</strong>{w["value.reliable.says"]}</li>
        <li><strong>{w["value.flowing"]}</strong>{w["value.flowing.says"]}</li>
        <li><strong>{w["value.helpful"]}</strong>{w["value.helpful.says"]}</li>
      </ul>
    </section>
  </main>

  <footer class="foot">
    <span class="mark small" set:html={mark}></span>
    <span>{w["brand"]} · Apache-2.0 · <a href="https://github.com/Straits-AI/mailda">Straits-AI/mailda</a> · <a href={`${base}/docs/agents/`}>{w["footer.decisions"]}</a> · <a href="https://github.com/Straits-AI/mailda/blob/main/SECURITY.md">{w["footer.security"]}</a></span>
  </footer>
</body>
</html>

<style>
  :global(html) { background: var(--ground); }
  body.landing { margin: 0; font: 400 1rem/1.6 var(--body); color: var(--text); background: var(--ground); }
  .landing a { color: var(--blue-text); text-underline-offset: .18em; }
  .masthead { max-width: 74rem; margin: 0 auto; padding: 1.1rem clamp(1rem, 4vw, 2.5rem); display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--rule); }
  .lockup { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; color: var(--text); font: 700 1.15rem/1 var(--display); letter-spacing: -0.01em; }
  .mark { display: inline-flex; width: 30px; color: var(--text); }
  .mark :global(svg) { width: 100%; height: auto; }
  .mark.small { width: 22px; opacity: .8; }
  .masthead-nav { display: flex; gap: 1.25rem; font: 400 .72rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
  .masthead-nav a { color: var(--dim); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: .15rem; }
  .masthead-nav a:hover { color: var(--text); border-bottom-color: var(--rule-strong); }

  main { max-width: 74rem; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2.5rem) 4rem; }
  .hero { padding: clamp(2.5rem, 7vw, 5rem) 0 2.5rem; max-width: 46rem; }
  .hero h1 { font: 700 clamp(2rem, 5vw, 3.4rem)/1.08 var(--display); letter-spacing: -0.03em; margin: 0 0 1rem; text-wrap: balance; }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.2rem); margin: 0 0 1.4rem; max-width: 42rem; }
  .owner { border-left: 2px solid var(--blue); padding: .2rem 0 .2rem 1rem; margin: 0 0 1.6rem; color: var(--dim); max-width: 42rem; }
  .owner .label { display: block; font: 400 .66rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--blue-text); margin-bottom: .35rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin: 0; align-items: center; }
  a.primary { display: inline-block; font: 400 .72rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ground); background: var(--blue-text); border: 1px solid var(--blue-text); padding: .85rem 1.2rem; text-decoration: none; }
  a.primary:hover { filter: brightness(1.12); }
  a.quiet { font: 400 .72rem/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--text); border: 1px solid var(--rule-strong); padding: .85rem 1.2rem; text-decoration: none; background: var(--ground-2); }
  a.quiet:hover { background: var(--sky); }

  /* The report: the product's own doctor output, as a list a screen reader walks in order. */
  .report { margin-top: 1.5rem; border-top: 1px solid var(--rule-strong); padding-top: 1.2rem; }
  .report-head { font: 400 .8rem/1.6 var(--mono); margin: 0 0 .9rem; display: flex; flex-wrap: wrap; gap: .4rem .8rem; align-items: baseline; letter-spacing: 0; }
  .report-head .cmd { color: var(--text); }
  .report-head .verdict { border: 1px solid var(--warn); color: var(--warn); padding: .1rem .45rem; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }
  .findings { list-style: none; margin: 0; padding: 0; }
  .finding { display: grid; grid-template-columns: 3.6rem 9rem minmax(0, 1fr); gap: .3rem 1rem; padding: .7rem 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .sev { font: 400 .66rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; padding: .15rem .35rem; border: 1px solid; justify-self: start; }
  .sev.ok { color: var(--live); border-color: var(--live); }
  .sev.warn { color: var(--warn); border-color: var(--warn); }
  .sev.report { color: var(--dim); border-color: var(--rule-strong); }
  .check { font: 400 .82rem/1.5 var(--mono); color: var(--text); overflow-wrap: anywhere; }
  .says { font-size: .95rem; }
  .says .doc { font: 400 .74rem/1 var(--mono); color: var(--dim); white-space: nowrap; margin-left: .35rem; }
  .report-foot { font-size: .85rem; margin: 1rem 0 0; }
  @media (max-width: 40rem) {
    .finding { grid-template-columns: 3.6rem minmax(0, 1fr); }
    .check { grid-column: 2; }
    .says { grid-column: 1 / -1; }
  }

  .install { margin-top: 3rem; max-width: 46rem; }
  .install h2, .values h2 { font: 700 1.4rem/1.2 var(--display); letter-spacing: -0.02em; margin: 0 0 .8rem; }
  .terminal { position: relative; background: var(--ink); color: #E8EDF3; font: 400 .82rem/1.65 var(--mono); border-left: 2px solid var(--blue); margin: 0 0 .9rem; }
  .terminal pre { margin: 0; padding: 1rem 5rem 1rem 1.2rem; overflow-x: auto; }
  .terminal .copy { position: absolute; top: .55rem; right: .6rem; font: 500 .72rem/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: #E8EDF3; background: transparent; border: 1px solid rgba(232, 237, 243, .35); border-radius: 3px; padding: .4rem .6rem; cursor: pointer; }
  .terminal .copy:hover, .terminal .copy:focus-visible { border-color: #E8EDF3; outline: none; }
  .terminal .copy[data-done] { color: var(--ink); background: #E8EDF3; }
  .dim { color: var(--dim); }
  .values { margin-top: 3rem; border-top: 1px solid var(--rule); padding-top: 1.5rem; }
  .values ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .8rem 2rem; font-size: .92rem; color: var(--dim); }
  .values strong { color: var(--text); font-family: var(--display); font-weight: 600; }
  .foot { max-width: 74rem; margin: 0 auto; padding: 1.2rem clamp(1rem, 4vw, 2.5rem) 2.5rem; border-top: 1px solid var(--rule); display: flex; gap: .8rem; align-items: center; font: 400 .72rem/1.6 var(--mono); color: var(--dim); flex-wrap: wrap; }
  .foot a { color: var(--dim); }
  @media (prefers-reduced-motion: no-preference) { a.primary { transition: filter .18s; } }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = document.getElementById(button.dataset.copy ?? "")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "copied";
        button.setAttribute("data-done", "");
        setTimeout(() => { button.textContent = "copy"; button.removeAttribute("data-done"); }, 1600);
      } catch {
        button.textContent = "select it";
      }
    });
  }
</script>
