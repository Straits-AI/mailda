{
  "name": "mailda-probe-node",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  // Mirrors the real `node` Worker: sole holder of every data binding.
  // Every resource is declared WITHOUT an id, which is what triggers provisioning.
  "d1_databases": [{ "binding": "CATALOG" }],
  "r2_buckets": [{ "binding": "EVIDENCE" }],
  "queues": {
    "producers": [{ "binding": "INBOUND", "queue": "mailda-probe-inbound" }]
  },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "MailboxDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxDO"] }],
  "services": [{ "binding": "EFFECTS", "service": "mailda-probe-effects" }]
}
